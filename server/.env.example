NODE_ENV=production
PUBLIC_URL=https://jbpsuport.online
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
APP_SECRET=
ADMIN_PASSWORD_HASH=
B2_ENDPOINT=https://s3.REGION.backblazeb2.com
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
# Set only with exactly one trusted reverse proxy and no direct public access.
TRUST_PROXY=0

# Small VPS profile (24 MP; one image decoder at a time)
MAX_IMAGE_PIXELS=24000000
MAX_UPLOAD_CONCURRENCY=1
MAX_THUMBNAIL_CONCURRENCY=1
IMAGE_PROCESS_CONCURRENCY=1
NODE_OPTIONS=--max-old-space-size=192
