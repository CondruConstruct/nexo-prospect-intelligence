[Unit]
Description=Activate QR Forever canonical domain once DNS and HTTPS are ready
After=network-online.target caddy.service qr-forever.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /opt/qr-forever/current/server/deploy/activate-domain.py
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
